+	require.Equal(t, "https://developers.openai.com/api/docs/guides/tools-web-search", gjson.GetBytes(outputJSON, "0.action.sources.0.url").String())
+	require.Equal(t, "message", gjson.GetBytes(outputJSON, "1.type").String())
+}
