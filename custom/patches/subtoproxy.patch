+	t.Cleanup(func() { _ = rdb.Close() })
+	store := NewBackgroundResponseTaskStore(rdb)
+
+	_, err := store.Get(context.Background(), "resp_bg_missing")
+	require.ErrorIs(t, err, service.ErrBackgroundResponseNotFound)
+}
